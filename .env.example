# Cucumber Studio Environment Variables
# Copy to .env.local for local development.

# Server
CUCUMBER_SERVER_PORT=3001
CUCUMBER_WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CUCUMBER_SERVER_BASE_URL=http://localhost:3001

# Supabase
CUCUMBER_SUPABASE_URL=https://your-project-ref.supabase.co
CUCUMBER_SUPABASE_ANON_KEY=your-anon-key
CUCUMBER_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Use the Supabase Dashboard "Connect" session pooler URL for local/dev workers.
# Replace the password placeholder with the real database password; URL-encode
# special characters such as #, %, @, :, /, ?, and &.
CUCUMBER_SUPABASE_DB_URL='postgresql://postgres.your-project-ref:[database-password]@aws-0-your-region.pooler.supabase.com:5432/postgres'
CUCUMBER_SUPABASE_PROJECT_ID=your-project-ref
CUCUMBER_SUPABASE_JWT_SECRET={"x":"...","y":"...","alg":"ES256","crv":"P-256","kty":"EC","key_ops":["verify"]}

# Supabase browser-safe
NEXT_PUBLIC_CUCUMBER_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_CUCUMBER_SUPABASE_ANON_KEY=your-anon-key
CUCUMBER_DEEPSEEK_API_KEY=
CUCUMBER_DEEPSEEK_API_BASE=https://api.deepseek.cn/v1

# Agent LLM
CUCUMBER_AGENT_BACKEND_MODE=state
CUCUMBER_AGENT_MODEL=google:gemini-3-flash-preview
CUCUMBER_OPENAI_API_KEY=
CUCUMBER_OPENAI_API_BASE=
CUCUMBER_GOOGLE_API_KEY=

# Seedream / Volcengine
CUCUMBER_VOLCENGINE_ACCESS_KEY_ID=
CUCUMBER_VOLCENGINE_SECRET_ACCESS_KEY=
CUCUMBER_SEEDREAM_REQ_KEY=jimeng_seedream46_cvtob
CUCUMBER_SEEDREAM_VIDEO_REQ_KEY=
CUCUMBER_SEEDREAM_HOST=visual.volcengineapi.com
CUCUMBER_SEEDREAM_REGION=cn-north-1
CUCUMBER_SEEDREAM_SERVICE=cv
CUCUMBER_SEEDREAM_VERSION=2022-08-31

# Skills & Sandbox
CUCUMBER_SKILLS_ROOT=../../skills

# Worker
# CUCUMBER_WORKER_IMAGE_CONCURRENCY=3
# CUCUMBER_WORKER_VIDEO_CONCURRENCY=2
# CUCUMBER_WORKER_POLL_INTERVAL_MS=2000

# Misc
CUCUMBER_GOOGLE_FONTS_API_KEY=
# GLOBAL_AGENT_HTTP_PROXY=http://127.0.0.1:7890
