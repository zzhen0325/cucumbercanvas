{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": false,
    "incremental": false,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@cucumber/canvas-core": ["../../packages/canvas-core/src/index.ts"],
      "@cucumber/pen-types": ["../../packages/pen-types/src/index.ts"],
      "@cucumber/pen-core": ["../../packages/pen-core/src/index.ts"],
      "@cucumber/pen-engine": ["../../packages/pen-engine/src/index.ts"],
      "@cucumber/pen-renderer": ["../../packages/pen-renderer/src/index.ts"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "test/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
